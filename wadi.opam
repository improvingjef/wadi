opam-version: "2.0"
synopsis: "Dune-free OCaml workspace toolbox"
description: """
wadi is a Dune-free OCaml workspace tool with cohesive subtools for build, test, run, bench, migration, install, diagnostics, and bootstrap workflows.
"""
maintainer: ["Jef Newsom <noreply@github.com>"]
authors: ["Jef Newsom"]
homepage: ["https://github.com/improvingjef/wadi"]
bug-reports: "https://github.com/improvingjef/wadi/issues"
dev-repo: "git+https://github.com/improvingjef/wadi.git"
license: "MIT"
depends: [
  "ocaml" {>= "5.4.0"}
  "ocamlfind"
]
build: [
  [make "release-artifacts"]
]
install: [
  [
    "./scripts/install_release_tree.sh"
    "--package-root"
    "package"
    "--binary"
    "_bootstrap/bin/wadi"
    "--prefix"
    prefix
  ]
]
